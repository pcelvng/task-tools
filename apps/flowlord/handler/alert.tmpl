<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flowlord: Alerts</title>
    <link rel="icon" type="image/svg+xml" href="{{if .isLocal}}./static{{else}}/static{{end}}/favicon.svg">
    <link rel="stylesheet" href="{{if .isLocal}}./static{{else}}/static{{end}}/style.css">
</head>
<body>
    {{template "header" .}}
    <div class="container full-width">
        <div class="summary-section">
            <h3>Alert Summary</h3>
            <div class="summary-grid">
                {{range .Summary}}
                <div class="summary-card">
                    <div class="summary-header">
                        <span class="summary-key">{{.Key}}</span>
                        <span class="summary-count">{{.Count}} alerts</span>
                    </div>
                    <div class="summary-time">{{.TimeRange}}</div>
                </div>
                {{end}}
            </div>
        </div>
        <div class="table-container">
            <table id="alertTable">
                <thead>
                    <tr>
                        <th class="sortable id-column" data-sort="id">ID</th>
                        <th class="sortable type-column" data-sort="type">Task Type</th>
                        <th class="sortable job-column" data-sort="job">Job</th>
                        <th class="sortable message-column" data-sort="message">Message</th>
                        <th class="sortable alerted-column" data-sort="alerted">Alerted At</th>
                        <th class="sortable tasktime-column" data-sort="tasktime">Task Time</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Alerts}}
                    <tr>
                        <td class="id-cell id-column truncated copyable" 
                            data-full-text="{{.TaskID}}"
                            title="{{if and .TaskID (ne .TaskID "unknown")}}Click to view tasks, right-click to copy{{else}}Right-click to copy{{end}}">
                            {{if and .TaskID (ne .TaskID "unknown")}}
                            <a class="task-id-link" href="{{if $.isLocal}}./task_preview.html{{else}}/web/task{{end}}?date={{if .TaskTime.IsZero}}{{.CreatedAt.Format "2006-01-02"}}{{else}}{{.TaskTime.Format "2006-01-02"}}{{end}}&id={{.TaskID}}">{{.TaskID}}</a>
                            {{else}}
                            {{.TaskID}}
                            {{end}}
                        </td>
                        <td class="type-cell type-column copyable" title="Right-click to copy">{{.Type}}</td>
                        <td class="job-cell job-column copyable" title="Right-click to copy">{{.Job}}</td>
                        <td class="message-cell message-column truncated copyable" 
                            data-full-text="{{.Msg}}"
                            title="Click to expand/collapse, right-click to copy">
                            {{.Msg}}
                        </td>
                        <td class="time-cell alerted-column copyable" title="Right-click to copy">{{.CreatedAt.Format "2006-01-02T15:04:05Z"}}</td>
                        <td class="time-cell tasktime-column copyable" title="Right-click to copy">{{if .TaskTime.IsZero}}N/A{{else}}{{.TaskTime.Format "2006-01-02T15"}}{{end}}</td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        <div class="stats">
            Total Alerts: <span id="totalCount">{{len .Alerts}}</span>
        </div>
    </div>

    <script src="{{if .isLocal}}./static{{else}}/static{{end}}/table-sort.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize table sorting with column type hints
            window.FlowlordTableSort.init('alertTable', {
                columnTypes: {
                    'alerted': 'datetime',
                    'tasktime': 'datetime'
                }
            });

            const tbody = document.querySelector('#alertTable tbody');
            if (!tbody) return;

            window.FlowlordUtils.enableCopyableCells(tbody);

            tbody.addEventListener('click', function(e) {
                if (e.target.closest('a.task-id-link')) return;
                const messageCell = e.target.closest('.message-cell.copyable');
                if (messageCell) {
                    e.stopPropagation();
                    window.FlowlordUtils.toggleField(messageCell, window.FlowlordUtils.copyableText(messageCell));
                }
            });
        });
    </script>
</body>
</html>
